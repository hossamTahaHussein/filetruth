# Host-side image for machines without a Linux host (Windows, macOS).
# It plays the role of the Linux host: it runs the API, CLI, tests and benchmark,
# and starts one filetruth-worker:local container per document through the
# mounted Docker socket. See "Run everything through Docker" in the README.
FROM python:3.12-slim-trixie
RUN apt-get update && apt-get install -y --no-install-recommends \
    docker-cli make curl fonts-dejavu-core libatomic1 && rm -rf /var/lib/apt/lists/*
COPY requirements.lock /deps/requirements.lock
RUN pip install --no-cache-dir -c /deps/requirements.lock \
    fastapi uvicorn PyMuPDF pypdfium2 pypdf python-docx Pillow lxml httpx
# Optional browser test dependencies.
RUN pip install --no-cache-dir playwright && python -m playwright install --with-deps chromium
# The worker binds each document by host path, so the temporary directory must
# sit at the same path inside this container and on the Docker host.
ENV PYTHONPATH=/work PYTHONDONTWRITEBYTECODE=1 FILETRUTH_SANDBOX=docker TMPDIR=/tmp/ftshare
WORKDIR /work
